SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
WORKSPACE_SESSION_SECRET=GENERATE_A_LONG_RANDOM_VALUE_FOR_PRODUCTION
SITE_URL=https://YOUR_SITE_SLUG.YOUR_WORKSPACE.chatgpt.site

# Staging에서는 예상 ref를 필수로 확인하고 운영 ref를 차단합니다.
APP_ENV=staging
EXPECTED_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
BLOCKED_SUPABASE_PROJECT_REFS=YOUR_PRODUCTION_PROJECT_REF

# 필수: 역할별 허용 암호를 쉼표로 구분합니다. 한글·영문 자판 대응값을 함께 등록할 수 있습니다.
INPUT_ACCESS_CODES=YOUR_INPUT_CODE,YOUR_INPUT_CODE_KEYBOARD_VARIANT
HTML_ACCESS_CODES=YOUR_HTML_CODE,YOUR_HTML_CODE_KEYBOARD_VARIANT
